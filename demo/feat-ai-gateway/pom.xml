<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tech.smartboot.feat</groupId>
    <artifactId>feat-ai-gateway</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>feat-ai-gateway</name>
    <description>OpenAI compatible LLM gateway data plane, built on feat</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <feat.version>2.4.3-SNAPSHOT</feat.version>
    </properties>

    <dependencies>
        <!--
          feat-cloud-starter = feat-cloud + feat-cloud-aot。
          后者是注解处理器：@Controller / @RequestMapping 是 SOURCE 级注解，
          路由由它在编译期生成，因此没有任何"运行时扫描"的余地。
        -->
        <dependency>
            <groupId>tech.smartboot.feat</groupId>
            <artifactId>feat-cloud-starter</artifactId>
            <version>${feat.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>feat-ai-gateway</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>tech.smartboot.feat.gateway.GatewayServer</mainClass>
                                </transformer>
                                <!-- 生成的 META-INF/services/...CloudService 必须合并，否则 ServiceLoader 只认最后一份 -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
